# Copy this file to .env.local and fill in real values. Do NOT put real
# secrets in THIS file — it is committed to git. Real values go in .env.local
# (gitignored) and in Vercel's Environment Variables.

# ---- Supabase ----
# From Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY, never expose to the browser. Used by the webhook to update orders.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Razorpay ----
# From Razorpay dashboard > Account & Settings > API Keys (use Test keys until KYC is approved)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
# A secret string YOU invent, then paste into Razorpay dashboard > Webhooks. Used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=invent-a-long-random-string

# ---- App ----
# Public base URL of your deployed site (used for payment-link callbacks). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Admin allow-list: comma-separated emails that may access /admin.
ADMIN_EMAILS=you@example.com

# Optional: protects the reservation-sweep cron endpoint.
CRON_SECRET=invent-another-random-string
